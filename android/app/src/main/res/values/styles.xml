<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
      parent=Theme.SplashScreen 인 이상 android:background(@drawable/splash)는 Android 12+
      플랫폼 SplashScreen API 에서 애초에 읽히지 않는다 — installSplashScreen() 이
      Activity.getSplashScreen() 을 직접 후킹해서, windowSplashScreenBackground /
      windowSplashScreenAnimatedIcon 을 명시하지 않으면 런처 아이콘(adaptive icon)을
      기본값으로 그려버린다(로그의 SplashScreenView Icon: ...ImmobileIconDrawable 로 확인).
      parent 를 바꿔도(AppTheme.NoActionBar) 이 경로가 비활성화되지 않으므로,
      아예 이 두 속성을 명시해서 우리 배경색/하트가 그려지게 한다.

      windowSplashScreenAnimatedIcon 은 런처 아이콘(@mipmap/ic_launcher_foreground)과
      의도적으로 분리된 전용 drawable(@drawable/splash_icon_with_title, BrandHeader를
      Playwright로 캡처한 하트+"Today Date" 타이틀 이미지)을 쓴다. 런처 아이콘은 하트만
      유지해야 하므로 같은 소스를 공유하지 않는다.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#f5f3ff</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_with_title</item>
    </style>
</resources>